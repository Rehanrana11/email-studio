        "matcher": "Bash|PowerShell|WebFetch|mcp__.*|.*[Ss]end.*|.*[Mm]ail.*|.*[Bb]roadcast.*|.*[Dd]eliver.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/send-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
