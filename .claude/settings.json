{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": { "source": "github", "repo": "anthropics/knowledge-work-plugins" }
    }
  },
  "enabledPlugins": {
    "marketing@knowledge-work-plugins": true
  },
  "permissions": {
    "deny": [
      "mcp__resend-practice__send-broadcast",
      "mcp__resend-practice__send-batch-emails",
      "mcp__resend-practice__create-broadcast",
      "mcp__resend-practice__create-api-key",
      "WebFetch(domain:api.resend.com)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|WebFetch|mcp__.*|.*[Ss]end.*|.*[Mm]ail.*|.*[Bb]roadcast.*|.*[Dd]eliver.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/studio-kit/hooks/send-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
